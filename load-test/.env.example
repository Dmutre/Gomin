# Gomin k6 load test — environment variables
# Three ready-made profiles: .env.small (~20 RPS), .env.medium (~70 RPS), .env.large (~200-300 RPS)
#
# Run (bash / Git Bash):
#   set -a; source load-test/.env.small; set +a
#   k6 run load-test/gomin-load-test.js
#
# Run (PowerShell):
#   Get-Content load-test\.env.small | ForEach-Object {
#     if ($_ -match '^([^#=\s]+)\s*=\s*(.*)$') { Set-Item "env:$($matches[1])" $matches[2] }
#   }
#   k6 run load-test/gomin-load-test.js

# ── Target ────────────────────────────────────────────────────────────────────
# HTTP API host — /api prefix is appended automatically
BASE_URL=http://localhost:3000

# WebSocket host — derived from BASE_URL if omitted (http→ws, https→wss)
# WS_URL=ws://localhost:3000

# ── Setup phase ───────────────────────────────────────────────────────────────
# Users registered AND logged in during setup (tokens cached — no login per iteration)
SETUP_USERS=60

# Independent group chats created — users are distributed across them
NUM_CHATS=3

# ── Load shape ────────────────────────────────────────────────────────────────
# Rough RPS formula: MAX_VUS × 7 req/iter ÷ 12s iteration time
MAX_VUS=35
RAMP_UP=1m
SUSTAIN=3m
SPIKE_VUS=50
SPIKE_DUR=1m

# ── Per-VU behaviour ─────────────────────────────────────────────────────────
# HTTP messages sent per VU per WebSocket session
MSG_PER_VU=5

# Seconds between messages (float, e.g. 1.5)
MSG_INTERVAL=2
