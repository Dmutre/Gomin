# Large load profile — target ~200-300 RPS
# 350 VUs × 7 req/iter ÷ ~12s = ~204 RPS  (spike: 500 VUs ≈ 292 RPS)
# Note: 500 VUs > 300 users — multiple VUs share session tokens (valid, sessions are not single-use)
# Setup registers 300 users sequentially — expect ~5 min setup time
BASE_URL=https://api.84.247.133.45.nip.io
SETUP_USERS=300
NUM_CHATS=12
MAX_VUS=350
RAMP_UP=3m
SUSTAIN=5m
SPIKE_VUS=500
SPIKE_DUR=2m
MSG_PER_VU=5
MSG_INTERVAL=2
